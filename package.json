    "@zerodevx/svelte-toast": "^0.9.5",
    "daisyui": "^5.5.19",
    "prettier": "^3.1.0",
    "prettier-plugin-svelte": "^3.2.6",
    "svelte": "^5.51.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.4",
    "vitest": "3.2.6"
  },
  "type": "module",
